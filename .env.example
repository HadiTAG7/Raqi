# كلمة المرور الوحيدة للدخول إلى التطبيق
APP_PASSWORD=change-me

# سر توقيع كوكي الجلسة (32 حرفاً أو أكثر، عشوائي). تغييره يُسجّل الخروج من كل الأجهزة.
# لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# قاعدة البيانات. محلياً يمكن تركهما فارغين فيُستخدم file:./data/local.db
# على Vercel يضيفهما تكامل Turso تلقائياً من تبويب Storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
